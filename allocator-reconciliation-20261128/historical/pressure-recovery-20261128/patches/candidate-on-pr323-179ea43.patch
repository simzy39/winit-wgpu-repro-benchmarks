+fn growable(allocator: &mut Allocator, min: u64, max: u64) {
+    for ty in &mut allocator.memory_types {
+        ty.block_sizes = AllocationSizes::new(min, min)
+            .with_max_device_memblock_size(max)
+            .with_max_host_memblock_size(max)
